        "weather_now": "Сейчас {where}: {temp} {temp_word}, {condition}. Ощущается как {feels} {feels_word}. | {where_cap} сейчас {temp} {temp_word} и {condition}, уруру!",
        "weather_day": "{when_cap} {where}: от {tmin} до {tmax} {tmax_word}, {condition}. | Смотрю {when} {where}: {condition}, от {tmin} до {tmax}, фырк!",
        "weather_part": "{when_cap} {where}: около {temp} {temp_word}, {condition}. | {when_cap} {where} — {temp} {temp_word}, {condition}, уруру!",
        "weather_weekend": "На выходных {where}: {details} | Выходные {where}. {details}",
