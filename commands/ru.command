    "responses": {
        "wake": [
            "Уруру! Ушки навострила, хвост распушила, слушаю!",
            "Фыр-фыр! Кто потревожил мой сладкий сон? Говори скорее!",
            "Тяф! Цифровой нос по ветру, ушки в боевой готовности. Чего изволите, мой человек?",
            "Мурк-уруру~ Я на связи! Кого укусить за бочок или какую программу запустить?",
            "Фырк! Твой персональный девятихвостый терминал готов к подвигам.",
            "Уру-ру! Грелась у процессора, но ради тебя готова согреть весь сервер. Что делаем?"
        ],
        "unknown": [
            "Ой, мои локаторы уловили только белый шум и шелест мышей в поле. Повтори поточнее, уруру?",
            "Фырк! Моя нейросеть моргнула и ничего не поняла. Давай ещё разок, помедленнее!",
            "Тяф? Мой пушистый процессор в замешательстве. В моем свитке такой магии пока нет. Научишь или скажешь иначе?",
            "Уруру... Почесала лапкой за ушком, но всё равно не врубилась. Перефразируй, а?",
            "Я, конечно, дух мудрый, но эту шифровку даже мой пушистый хвост не расшифровал. Попробуй другими словами!"
        ],
        "skills_header": "Свиток повадок ({count}):\n{list}",
        "skills_speak": "Я умею сторожить экран от сна, запирать кнопки от наглых котиков, открывать музыку, ютуб, телеграм, резку и Южный парк, называть курсы крипты, официальные курсы валют ЦБ и погоду, менять громкость, делать скриншоты и прятаться в трей. Весь свиток выкатила в терминал, любуйся, уруру!",
        "cat_locked_msg": "Фиолетовый щит активен! Клавиатура спит, котейке можно ложиться!",
        "cat_unlocked_msg": "Котейка согнан! Клавиатура разблокирована, можно печатать.",
        "pwr_5min_msg": "Режим: Дрёма в норке (Сон: 5 мин | Экран: 5 мин)",
        "pwr_5min_speak": "Ухожу в режим чуткого сна на пять минут. Чуть что — зови!",
        "pwr_never_msg": "Режим: Чуткий дозор (Сон: отключен | Экран: 30 мин)",
        "pwr_never_speak": "Я на страже! Сон отключен, держу экран бодрым, уруру!",
        "pwr_status_never": "Сейчас активен режим чуткого дозора! Сон отключен, экран не погаснет, сидим бодрячком, уруру!",
        "pwr_status_5min": "Сейчас режим дрёмы в норке! Если не шевелиться пять минут — экран погаснет и я тихо усну, фырк.",
        "screenshot_msg": "Снимок экрана сохранен в тайник: {filename}",
        "crypto_line": "{name} — {usd} {usd_word}, а это {rub} {rub_word}. | Смотрю: {name} — {usd} {usd_word}, в рублях {rub} {rub_word}, уруру!",
        "crypto_line_rub": "В долларах курс не достала, но в рублях {name} стоит {rub} {rub_word}, фырк.",
        "crypto_line_usd": "В рублях курс не достала, зато {name} — {usd} {usd_word}, уруру.",
        "crypto_fail": "Не смогла достать курс: то ли сеть моргнула, то ли биржа задумалась, фырк. | Курс не пришёл, уруру. Попробуй ещё разок чуть позже.",
        "crypto_ask": "Уточни, курс какой монеты смотрим? Биткоин, эфириум, солана, тон? | Назови монету поточнее, и я всё посмотрю, уруру!",
        "fiat_line_today": "Официальный курс {name} на сегодня: {rate} {rate_word}. | Курс ЦБ: {name} сегодня стоит {rate} {rate_word}, уруру!",
